# Copy to .env for local development (`npm run dev:all`), and add the same
# names under Vercel > Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# VITE_PAYSTACK_PUBLIC_KEY: Paystack PUBLIC key, used by the checkout popup.
# Starts with pk_test_ (test mode) or pk_live_ (live mode).
# Safe to expose in the browser: Vite inlines every VITE_* var into the bundle
# at BUILD time, so after changing it you must rebuild/redeploy - editing it at
# runtime does nothing.
# Get it from https://dashboard.paystack.co/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=""

# PAYSTACK_SECRET_KEY: server-side ONLY. Used to verify transactions and to
# validate webhook signatures. It must NEVER be prefixed with VITE_ and must
# never reach the browser - a VITE_ var ships to every visitor.
# Read per request by server/ (local) and api/index.ts (Vercel), so a key added
# in the Vercel dashboard takes effect without a rebuild.
# PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"

# PAYSTACK_API_BASE: optional. Overrides https://api.paystack.co - useful for
# pointing the server at a stub in tests.
# PAYSTACK_API_BASE="https://api.paystack.co"

# PORT / HOST: where `npm run server` listens. The Vite dev server proxies
# /api to http://127.0.0.1:3001, so change both together if you change it.
# PORT=3001
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# AI Studio (not used by the Vercel deployment)

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
